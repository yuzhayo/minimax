<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Foundation\AppFoundation.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.23" />
    <Compile Include="..\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\Features\**\*.cs" Link="Features\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\App\*.cs" Link="App\%(Filename)%(Extension)" />
    <Compile Include="..\Areas\**\*.cs" Link="Areas\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\MiniMaxForm.cs" Link="MiniMaxForm.cs" />
    <Compile Include="..\UI\*.cs" Link="UI\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
